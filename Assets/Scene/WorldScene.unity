    m_MinSize: 1
    m_MaxSize: 18
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Torpedo - launches a Dockable Container from the crosshair\nPressurize
    - pressurize current room\nVent - depressurize current room\nRefill - refuels
    inventory equipment and current vessel\u2019s capacitor and system tanks\nCollision
    - disables collision for current vessel\nSpawn <item_name> <tier> - spawns an
    item of the specified tier, ex: \u201Cspawn injector 4\u201D\nGod <1 or 0> -
    enables or disables god mode\nTeleport <name> - teleports player to another player
    (character name or steam name) or vessel (ship/station name or registration number),
    ex: teleport B1\nCountships <range_meters> or <planet/moon> - lists all vessels
    in radius or near moon/planet\nSelfdestruct <seconds> - activates self destruct
    timer for current vessel\nStation <name> - spawns premade station (station file
    must be inside \\Data\\Stations\\) ex: spawn Industrial1"
